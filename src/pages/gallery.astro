---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid';
import { getCollection } from 'astro:content';
import EditableText from '../components/editor/EditableText';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

// Fetch gallery from Content Collection, sort by order field
const galleryEntries = await getCollection('gallery');
galleryEntries.sort((a, b) => a.data.order - b.data.order);

// Map to the format expected by GalleryGrid component
const galleryItems = galleryEntries.map(entry => ({
  id: entry.id,
  title: entry.data.title,
  technique: entry.data.technique,
  dimensions: entry.data.dimensions || '',
  year: entry.data.year,
  src: entry.data.image.startsWith('http') ? entry.data.image : `${base}${entry.data.image}`,
  width: entry.data.width,
  height: entry.data.height,
  aspectRatio: entry.data.width / entry.data.height,
  order: entry.data.order,
}));

const siteUrl = 'https://fractalia.art';
const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${siteUrl}/gallery#webpage`,
  url: `${siteUrl}/gallery`,
  name: 'Galería de Obras al Óleo · Lía Paz',
  description: 'Colección completa de obras originales al óleo, estudios figurativos y pinturas en vivo creadas por la artista visual Lía Paz.',
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: { '@id': `${siteUrl}/#artist` },
  inLanguage: 'es-MX',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: galleryItems.length,
    itemListElement: galleryItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'VisualArtwork',
        name: item.title,
        image: item.src.startsWith('http') ? item.src : `${siteUrl}${item.src}`,
        creator: { '@id': `${siteUrl}/#artist` },
        artMedium: item.technique || 'Óleo sobre lienzo',
        artform: 'Pintura',
        dateCreated: item.year,
        ...(item.dimensions ? { size: item.dimensions } : {}),
      },
    })),
  },
};
---

<BaseLayout
  title="Galería de Obras al Óleo · Lía Paz | Colección de Arte"
  description="Colección completa de obras originales al óleo, estudios figurativos y pinturas en vivo creadas por la artista visual Lía Paz (Fractalia)."
  image={galleryItems[0]?.src || '/images/gallery/mares-de-silencio.webp'}
  imageAlt="Colección de obras al óleo de Lía Paz"
  jsonLd={gallerySchema}
>
  <!-- Page Header -->
  <section class="py-16 md:py-24 border-b border-neutral-100 bg-neutral-50/50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <EditableText
        client:load
        contentKey="gallery.header.label"
        defaultText="Colección & Archivo"
        as="span"
        className="font-sans text-[11px] tracking-[0.3em] uppercase text-neutral-400 font-medium block mb-3"
      />
      <EditableText
        client:load
        contentKey="gallery.header.title"
        defaultText="Galería de Obras"
        as="h1"
        className="font-serif text-4xl sm:text-5xl md:text-6xl text-neutral-900 font-normal tracking-wide block"
      />
      <EditableText
        client:load
        contentKey="gallery.header.desc"
        defaultText="Colección completa de obras al óleo y técnicas tradicionales. Haz clic sobre cualquier obra para abrirla y consultar su ficha técnica."
        as="p"
        className="font-sans text-sm sm:text-base text-neutral-500 font-light max-w-xl mx-auto mt-4 leading-relaxed block"
        multiline
      />
    </div>
  </section>

  <!-- Interactive Grid Island -->
  <section class="py-12 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <GalleryGrid
        client:load
        items={galleryItems}
      />
    </div>
  </section>
</BaseLayout>

