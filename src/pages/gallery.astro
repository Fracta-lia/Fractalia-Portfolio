---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid';
import rawGalleryData from '../data/gallery.json';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

// Format item paths with base path
const galleryItems = rawGalleryData.map(item => ({
  ...item,
  src: item.src.startsWith('http') ? item.src : `${base}${item.src}`
}));
---

<BaseLayout
  title="Galería de Obras · Lía Paz | Colección de Pintura"
  description="Colección de obras originales, wedding live paintings y retratos al óleo creados por la artista Lía Paz."
>
  <!-- Page Header -->
  <section class="py-16 md:py-24 border-b border-neutral-100 bg-neutral-50/50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="font-sans text-[11px] tracking-[0.3em] uppercase text-neutral-400 font-medium block mb-3">
        Colección & Archivo
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl text-neutral-900 font-normal tracking-wide">
        Galería de Obras
      </h1>
      <p class="font-sans text-sm sm:text-base text-neutral-500 font-light max-w-xl mx-auto mt-4 leading-relaxed">
        Explora la selección de pinturas en vivo, retratos por encargo y piezas de estudio. Haz clic sobre cualquier obra para verla en detalle.
      </p>
    </div>
  </section>

  <!-- Interactive Grid Island -->
  <section class="py-12 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <GalleryGrid
        client:load
        items={galleryItems}
        initialCategory="all"
        showFilters={true}
      />
    </div>
  </section>
</BaseLayout>

