---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import AboutEditor from '../components/editor/AboutEditor';
import EditableText from '../components/editor/EditableText';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const aboutEntry = await getEntry('pages', 'about');
const portrait = aboutEntry?.data.portrait ?? '/images/about/lia-paz.webp';
const quote = aboutEntry?.data.quote ?? 'Creo firmemente que el arte plástico tiene el poder de capturar lo que la fotografía muchas veces pasa por alto: el peso del aire, la intensidad de un gesto y el calor de una emoción compartida.';
const bio = aboutEntry?.body ?? `Hola, soy **Lía Paz**. Mi pasión reside en traducir la vida, la intimidad y las celebraciones humanas al lenguaje atemporal del óleo y las artes visuales.

A lo largo de mi trayectoria he explorado diversas disciplinas plásticas, consolidando mi enfoque en la pintura figurativa contemporánea, el estudio anatómico y la captura de instantes fugaces en vivo.

La experiencia del **Wedding Live Painting** nació como una forma orgánica de unir la celebración más significativa de una pareja con el proceso alquímico de la pintura en tiempo real. Ver cómo una obra evoluciona frente a los ojos de los novios e invitados transforma el evento en un recuerdo tangible que perdurará por generaciones.`;
---

<BaseLayout
  title="Sobre Lía Paz · Biografía & Filosofía Artística"
  description="Conoce más sobre Lía Paz, artista visual y pintora especializada en live paintings de bodas y retratos clásicos contemporáneos."
>
  <!-- Page Header -->
  <section class="py-16 md:py-24 border-b border-neutral-100 bg-neutral-50/50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <EditableText
        client:load
        contentKey="about.header.label"
        defaultText="Perfil & Trayectoria"
        as="span"
        className="font-sans text-[11px] tracking-[0.3em] uppercase text-neutral-400 font-medium block mb-3"
      />
      <EditableText
        client:load
        contentKey="about.header.title"
        defaultText="Sobre la Artista"
        as="h1"
        className="font-serif text-4xl sm:text-5xl md:text-6xl text-neutral-900 font-normal tracking-wide block"
      />
    </div>
  </section>

  <!-- Bio Main Section (Sean Layh style 2-column layout with In-Situ Editing) -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
      <AboutEditor
        client:load
        initialPortrait={portrait}
        initialQuote={quote}
        initialBio={bio}
        base={base}
      />
    </div>
  </section>
</BaseLayout>

