---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import HomeVisionEditor from '../components/editor/HomeVisionEditor';
import EditableText from '../components/editor/EditableText';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

// Fetch gallery from Content Collection for featured works preview
const galleryEntries = await getCollection('gallery');
galleryEntries.sort((a, b) => a.data.order - b.data.order);
const featuredWorks = galleryEntries.slice(0, 4).map(entry => ({
  title: entry.data.title,
  src: entry.data.image.startsWith('http') ? entry.data.image : `${base}${entry.data.image}`,
}));

// Fetch home page editable content
const homeEntry = await getEntry('pages', 'home');
const heroImage = homeEntry?.data.heroImage ?? '/images/gallery/mares-de-silencio.webp';
const visionQuote = homeEntry?.data.artisticVisionQuote ?? 'Cada pincelada guarda un latido.';
---

<BaseLayout
  title="Lía Paz · Artista Visual | Fine Art & Live Paintings"
  description="Página oficial de Lía Paz. Pintura en vivo para bodas (Wedding Live Paintings), retratos personalizados por encargo y obra en óleo."
>
  <!-- HERO SECTION (Sean Layh style: minimal, spacious, impactful) -->
  <section class="relative min-h-[82vh] md:min-h-[88vh] flex items-center justify-center bg-neutral-950 text-white overflow-hidden px-6">
    <!-- Background Hero Artwork with subtle vignette -->
    <div class="absolute inset-0 z-0">
      <img
        src={heroImage.startsWith('http') ? heroImage : `${base}${heroImage}`}
        alt="Obra destacada de Lía Paz"
        class="w-full h-full object-cover opacity-55 scale-105 transition-transform duration-1000 ease-out"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/90 via-neutral-950/25 to-neutral-950/40" />
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-4xl mx-auto text-center py-20 flex flex-col items-center">
      <EditableText
        client:load
        contentKey="home.hero.tagline"
        defaultText="Artista Visual · Fine Art"
        as="span"
        className="font-sans text-[11px] sm:text-xs tracking-[0.35em] text-neutral-400 uppercase font-light mb-4"
      />

      <EditableText
        client:load
        contentKey="home.hero.title"
        defaultText="Lía Paz"
        as="h1"
        className="font-serif text-5xl sm:text-7xl md:text-8xl tracking-[0.18em] uppercase font-light text-white mb-10 leading-none"
      />

      <div class="flex flex-col sm:flex-row items-center gap-4">
        <a
          href={`${base}/gallery`}
          class="w-full sm:w-auto px-8 py-4 bg-white text-neutral-950 hover:bg-neutral-200 text-xs font-sans tracking-[0.25em] uppercase font-medium transition-colors duration-300"
        >
          <EditableText client:load contentKey="home.hero.cta1" defaultText="Ver Galería" as="span" />
        </a>
        <a
          href={`${base}/services`}
          class="w-full sm:w-auto px-8 py-4 border border-white/60 text-white hover:bg-white hover:text-neutral-950 text-xs font-sans tracking-[0.25em] uppercase font-medium transition-all duration-300"
        >
          <EditableText client:load contentKey="home.hero.cta2" defaultText="Comisiones" as="span" />
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center opacity-60 hover:opacity-100 transition-opacity">
      <span class="text-[10px] uppercase tracking-[0.3em] font-sans text-neutral-400 mb-2">Descubrir</span>
      <div class="w-[1px] h-8 bg-neutral-500 animate-pulse"></div>
    </div>
  </section>

  <!-- ARTIST STATEMENT / PHILOSOPHY QUOTE (Editable) -->
  <HomeVisionEditor
    client:load
    initialQuote={visionQuote}
    heroImage={heroImage}
  />

  <!-- 1. FEATURED GALLERY / PORTFOLIO PREVIEW (Sean Layh style: pure visual cards) -->
  <section class="py-20 md:py-28 bg-white border-b border-neutral-200/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-16">
        <div>
          <EditableText
            client:load
            contentKey="home.gallery.label"
            defaultText="Portfolio"
            as="span"
            className="font-sans text-[11px] tracking-[0.25em] uppercase text-neutral-400 block mb-2 font-medium"
          />
          <EditableText
            client:load
            contentKey="home.gallery.title"
            defaultText="Galería de Obras"
            as="h2"
            className="font-serif text-3xl sm:text-4xl md:text-5xl text-neutral-900 font-normal tracking-wide"
          />
        </div>
        <a
          href={`${base}/gallery`}
          class="mt-4 md:mt-0 font-sans text-xs tracking-[0.2em] uppercase text-neutral-800 hover:text-black font-medium inline-flex items-center group"
        >
          <EditableText client:load contentKey="home.gallery.cta" defaultText="Ver colección completa" as="span" />
          <span class="ml-2 group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredWorks.map(item => (
          <a
            href={`${base}/gallery`}
            aria-label={`Ver ${item.title} en galería`}
            class="group relative block aspect-[4/5] bg-neutral-100 overflow-hidden border border-neutral-200/70 shadow-sm"
          >
            <img
              src={item.src}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
          </a>
        ))}
      </div>

      <div class="text-center mt-12 md:mt-16">
        <a
          href={`${base}/gallery`}
          class="inline-block px-9 py-4 border border-neutral-900 text-neutral-900 hover:bg-neutral-900 hover:text-white text-xs font-sans tracking-[0.25em] uppercase transition-colors duration-300 font-medium"
        >
          Explorar Galería Completa
        </a>
      </div>
    </div>
  </section>

  <!-- 2. SERVICES SECTION: RETRATOS & BODAS -->
  <section class="py-20 md:py-28 bg-neutral-50/70">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-16">
        <div>
          <EditableText
            client:load
            contentKey="home.services.label"
            defaultText="Encargos & Servicios"
            as="span"
            className="font-sans text-[11px] tracking-[0.25em] uppercase text-neutral-400 block mb-2 font-medium"
          />
          <EditableText
            client:load
            contentKey="home.services.title"
            defaultText="Retratos & Bodas"
            as="h2"
            className="font-serif text-3xl sm:text-4xl md:text-5xl text-neutral-900 font-normal tracking-wide"
          />
        </div>
        <a
          href={`${base}/services`}
          class="mt-4 md:mt-0 font-sans text-xs tracking-[0.2em] uppercase text-neutral-800 hover:text-black font-medium inline-flex items-center group"
        >
          <span>Conocer detalles & tarifas</span>
          <span class="ml-2 group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <!-- Service Card 1: Retratos (First) -->
        <div class="bg-white border border-neutral-200/70 p-8 sm:p-10 flex flex-col justify-between group hover:border-neutral-400 transition-all duration-300">
          <div>
            <div class="aspect-[16/10] overflow-hidden bg-neutral-100 mb-6">
              <img
                src={`${base}/images/gallery/retrato-nick.webp`}
                alt="Retratos Personalizados al Óleo"
                class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <EditableText
              client:load
              contentKey="home.services.card1.subtitle"
              defaultText="Encargos Exclusivos"
              as="span"
              className="font-sans text-[10px] tracking-[0.25em] uppercase text-neutral-400 font-medium"
            />
            <EditableText
              client:load
              contentKey="home.services.card1.title"
              defaultText="Retratos por Encargo"
              as="h3"
              className="font-serif text-2xl sm:text-3xl text-neutral-900 font-normal tracking-wide mt-1 mb-3"
            />
            <EditableText
              client:load
              contentKey="home.services.card1.desc"
              defaultText="Retratos individuales, parejas o familias realizados en óleo y técnicas tradicionales a partir de sesiones fotográficas o momentos significativos."
              as="p"
              className="font-sans text-neutral-600 text-sm leading-relaxed font-light mb-6"
              multiline
            />
          </div>
          <div>
            <a
              href={`${base}/services`}
              class="inline-block font-sans text-xs tracking-[0.2em] uppercase text-neutral-900 font-medium underline underline-offset-8 hover:text-neutral-600 transition-colors"
            >
              <EditableText client:load contentKey="home.services.card1.cta" defaultText="Explorar Retratos" as="span" /> &rarr;
            </a>
          </div>
        </div>

        <!-- Service Card 2: Wedding Live Painting (Second) -->
        <div class="bg-white border border-neutral-200/70 p-8 sm:p-10 flex flex-col justify-between group hover:border-neutral-400 transition-all duration-300">
          <div>
            <div class="aspect-[16/10] overflow-hidden bg-neutral-100 mb-6">
              <img
                src={`${base}/images/gallery/manos-y-anillo.webp`}
                alt="Wedding Live Painting para Bodas"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <EditableText
              client:load
              contentKey="home.services.card2.subtitle"
              defaultText="Bodas & Celebraciones"
              as="span"
              className="font-sans text-[10px] tracking-[0.25em] uppercase text-neutral-400 font-medium"
            />
            <EditableText
              client:load
              contentKey="home.services.card2.title"
              defaultText="Wedding Live Painting"
              as="h3"
              className="font-serif text-2xl sm:text-3xl text-neutral-900 font-normal tracking-wide mt-1 mb-3"
            />
            <EditableText
              client:load
              contentKey="home.services.card2.desc"
              defaultText="Pintura en vivo durante el evento. Los invitados presencian cómo el primer baile, la ceremonia o la recepción cobra vida sobre lienzo en tiempo real."
              as="p"
              className="font-sans text-neutral-600 text-sm leading-relaxed font-light mb-6"
              multiline
            />
          </div>
          <div>
            <a
              href={`${base}/services`}
              class="inline-block font-sans text-xs tracking-[0.2em] uppercase text-neutral-900 font-medium underline underline-offset-8 hover:text-neutral-600 transition-colors"
            >
              <EditableText client:load contentKey="home.services.card2.cta" defaultText="Ver Live Painting" as="span" /> &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARTIST CALLOUT BANNER -->
  <section class="py-20 md:py-24 bg-neutral-900 text-white">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 flex flex-col md:flex-row items-center gap-10 md:gap-16">
      <div class="w-48 h-48 md:w-64 md:h-64 rounded-none overflow-hidden bg-neutral-800 flex-shrink-0 border border-neutral-700">
        <img
          src={`${base}/images/about/lia-paz.webp`}
          alt="Lía Paz"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="flex-grow text-center md:text-left space-y-4">
        <EditableText
          client:load
          contentKey="home.about.label"
          defaultText="Sobre la Artista"
          as="span"
          className="font-sans text-[11px] tracking-[0.25em] uppercase text-neutral-400"
        />
        <EditableText
          client:load
          contentKey="home.about.title"
          defaultText="Lía Paz"
          as="h3"
          className="font-serif text-3xl sm:text-4xl text-white font-normal"
        />
        <EditableText
          client:load
          contentKey="home.about.p1"
          defaultText="Artista visual enfocada en la creación plástica, pintura figurativa y memoria tangible. Con una sensibilidad enfocada en la luz y los gestos sutiles, cada pieza busca preservar lo irrepetible."
          as="p"
          className="font-sans text-sm sm:text-base text-neutral-300 font-light leading-relaxed"
          multiline
        />
        <div class="pt-2">
          <a
            href={`${base}/about`}
            class="inline-block text-xs font-sans tracking-[0.2em] uppercase text-white hover:text-neutral-300 underline underline-offset-8"
          >
            <EditableText client:load contentKey="home.about.cta" defaultText="Leer Biografía Completa" as="span" /> &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA CONTACT BANNER -->
  <section class="py-20 md:py-24 bg-neutral-50 text-center">
    <div class="max-w-3xl mx-auto px-6">
      <EditableText
        client:load
        contentKey="services.banner.title"
        defaultText="¿Hablamos sobre un encargo de retrato o tu próxima boda?"
        as="h3"
        className="font-serif text-3xl sm:text-4xl text-neutral-900 font-normal mb-4"
      />
      <EditableText
        client:load
        contentKey="services.banner.desc"
        defaultText="Disponibilidad para encargos de retratos personalizados y fechas exclusivas de Wedding Live Painting. Contáctame para verificar agenda y resolver dudas."
        as="p"
        className="font-sans text-sm text-neutral-600 font-light max-w-xl mx-auto mb-8 leading-relaxed"
        multiline
      />
      <a
        href={`${base}/contact`}
        class="inline-block px-10 py-4 bg-neutral-900 text-white hover:bg-neutral-800 text-xs font-sans tracking-[0.25em] uppercase font-medium transition-colors duration-200"
      >
        <EditableText client:load contentKey="services.banner.cta" defaultText="Escríbeme Ahora" as="span" />
      </a>
    </div>
  </section>
</BaseLayout>
