---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import EditableText from '../components/editor/EditableText';

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const siteUrl = 'https://fractalia.art';
const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${siteUrl}/services#business`,
  name: 'Lía Paz · Wedding Live Painting & Fine Art',
  url: `${siteUrl}/services`,
  image: `${siteUrl}/images/services/wedding-live.svg`,
  email: 'liapazart@gmail.com',
  priceRange: '$$$',
  currenciesAccepted: 'MXN, USD',
  areaServed: [
    { '@type': 'Country', name: 'México' },
    { '@type': 'Country', name: 'Internacional' }
  ],
  provider: { '@id': `${siteUrl}/#artist` },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de Arte por Encargo y en Vivo',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Wedding Live Painting (Pintura en Vivo para Bodas)',
          description: 'Creación de una obra pictórica al óleo en tiempo real durante la ceremonia o fiesta de bodas, capturando a los novios y el ambiente del evento.',
          provider: { '@id': `${siteUrl}/#artist` }
        }
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Retratos al Óleo por Encargo',
          description: 'Retratos personalizados de autor trabajados al óleo sobre lienzo con rigor anatómico y sensibilidad lumínica a partir de sesiones o referencias.',
          provider: { '@id': `${siteUrl}/#artist` }
        }
      }
    ]
  }
};
---

<BaseLayout
  title="Wedding Live Painting & Retratos al Óleo · Lía Paz | Servicios"
  description="Servicios artísticos exclusivos: pintura en vivo para bodas (Wedding Live Painting) y encargo de retratos al óleo sobre lienzo por la artista visual Lía Paz."
  image="/images/services/wedding-live.svg"
  imageAlt="Wedding Live Painting y Retratos al Óleo por Lía Paz"
  jsonLd={servicesSchema}
>
  <!-- Page Header -->
  <section class="py-12 sm:py-16 md:py-24 border-b border-neutral-100 bg-neutral-50/50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <EditableText
        client:load
        contentKey="services.header.label"
        defaultText="Experiencias & Encargos"
        as="span"
        className="font-sans text-[11px] tracking-[0.3em] uppercase text-neutral-400 font-medium block mb-3"
      />
      <EditableText
        client:load
        contentKey="services.header.title"
        defaultText="Servicios Artísticos"
        as="h1"
        className="font-serif text-4xl sm:text-5xl md:text-6xl text-neutral-900 font-normal tracking-wide"
      />
      <EditableText
        client:load
        contentKey="services.header.desc"
        defaultText="Obras de arte hechas a mano que celebran los lazos humanos y momentos irrepetibles."
        as="p"
        className="font-sans text-sm sm:text-base text-neutral-500 font-light max-w-xl mx-auto mt-4 leading-relaxed"
        multiline
      />
    </div>
  </section>

  <!-- Detailed Services Section -->
  <section class="py-10 sm:py-14 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      
      <!-- Service 1: Retratos por Encargo (First) -->
      <ServiceCard
        keyPrefix="services.s1"
        title="Retratos Personalizados"
        tagline="Comisiones & Arte Figurativo"
        description="Retratos al óleo sobre lienzo o lino que buscan captar la esencia, mirada y carácter del retratado. Perfecto como homenaje personal, regalo de aniversario o legado familiar atemporal."
        details={[
          "Retratos individuales, parejas, familias o retratos conmemorativos",
          "Trabajo a partir de fotografías de alta resolución o sesión guiada",
          "Boceto tonal previo y validación de paleta de color con el cliente",
          "Capas sucesivas al óleo tradicional con veladuras para máxima luminosidad",
          "Múltiples formatos disponibles: desde 30x40 cm hasta grandes formatos de 100x120 cm",
          "Certificado de autenticidad firmado por la artista"
        ]}
        image={`${base}/images/gallery/retrato-nick.webp`}
        ctaText="Cotizar mi Retrato"
        ctaHref="/contact"
        reversed={false}
      />

      <!-- Service 2: Wedding Live Painting (Second) -->
      <ServiceCard
        keyPrefix="services.s2"
        title="Wedding Live Paintings"
        tagline="Experiencia en Vivo para Bodas"
        description="Una experiencia artística inmersiva que combina entretenimiento en directo para tus invitados y una obra de arte original que atesorarán para siempre. Pinto en tiempo real el instante más emblemático de su unión: la ceremonia, el intercambio de votos o su primer baile como esposos."
        details={[
          "Llegada de 2 a 3 horas antes del inicio para pintar la arquitectura y atmósfera del recinto",
          "Pintura en vivo durante el cóctel y la fiesta (5 a 7 horas en sitio)",
          "Interacción cálida y respetuosa con los invitados durante el proceso",
          "Retoques finales y barniz protector UV en el estudio",
          "Lienzo de lino profesional montado en bastidor de madera de cedro",
          "Entrega personal o envío seguro cuidadosamente embalado"
        ]}
        image={`${base}/images/gallery/manos-y-anillo.webp`}
        ctaText="Consultar Fecha de Boda"
        ctaHref="/contact"
        reversed={true}
      />

    </div>
  </section>

  <!-- Wedding Live Painting Step-by-Step Process -->
  <section class="py-14 sm:py-20 md:py-28 bg-neutral-50 border-t border-b border-neutral-200/60">
    <div class="max-w-5xl mx-auto px-6 sm:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
        <EditableText
          client:load
          contentKey="services.process.label"
          defaultText="Paso a Paso"
          as="span"
          className="font-sans text-[11px] tracking-[0.25em] uppercase text-neutral-400 font-medium block mb-2"
        />
        <EditableText
          client:load
          contentKey="services.process.title"
          defaultText="¿Cómo funciona el Wedding Live Painting?"
          as="h2"
          className="font-serif text-3xl sm:text-4xl text-neutral-900 font-normal"
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
        <!-- Step 1 -->
        <div class="p-6 bg-white border border-neutral-200/70 relative reveal-on-scroll">
          <span class="font-serif text-3xl text-neutral-300 font-light block mb-2">01</span>
          <EditableText
            client:load
            contentKey="services.process.s1.title"
            defaultText="Contacto & Fecha"
            as="h3"
            className="font-serif text-lg text-neutral-900 font-normal mb-2"
          />
          <EditableText
            client:load
            contentKey="services.process.s1.desc"
            defaultText="Verificamos disponibilidad de agenda, lugar del evento y seleccionamos las dimensiones del lienzo."
            as="p"
            className="font-sans text-xs text-neutral-500 leading-relaxed font-light"
            multiline
          />
        </div>

        <!-- Step 2 -->
        <div class="p-6 bg-white border border-neutral-200/70 relative reveal-on-scroll delay-100">
          <span class="font-serif text-3xl text-neutral-300 font-light block mb-2">02</span>
          <EditableText
            client:load
            contentKey="services.process.s2.title"
            defaultText="Montaje Previo"
            as="h3"
            className="font-serif text-lg text-neutral-900 font-normal mb-2"
          />
          <EditableText
            client:load
            contentKey="services.process.s2.desc"
            defaultText="Llego horas antes para instalar caballete francés e iniciar el fondo arquitectónico y lumínico."
            as="p"
            className="font-sans text-xs text-neutral-500 leading-relaxed font-light"
            multiline
          />
        </div>

        <!-- Step 3 -->
        <div class="p-6 bg-white border border-neutral-200/70 relative reveal-on-scroll delay-200">
          <span class="font-serif text-3xl text-neutral-300 font-light block mb-2">03</span>
          <EditableText
            client:load
            contentKey="services.process.s3.title"
            defaultText="Pintura en Vivo"
            as="h3"
            className="font-serif text-lg text-neutral-900 font-normal mb-2"
          />
          <EditableText
            client:load
            contentKey="services.process.s3.desc"
            defaultText="Pinto a los novios en vivo. Los invitados disfrutan observando la magia del cuadro tomando forma."
            as="p"
            className="font-sans text-xs text-neutral-500 leading-relaxed font-light"
            multiline
          />
        </div>

        <!-- Step 4 -->
        <div class="p-6 bg-white border border-neutral-200/70 relative reveal-on-scroll delay-300">
          <span class="font-serif text-3xl text-neutral-300 font-light block mb-2">04</span>
          <EditableText
            client:load
            contentKey="services.process.s4.title"
            defaultText="Detalle & Entrega"
            as="h3"
            className="font-serif text-lg text-neutral-900 font-normal mb-2"
          />
          <EditableText
            client:load
            contentKey="services.process.s4.desc"
            defaultText="Toques finales en estudio, barnizado protector y entrega lista para lucir en su nuevo hogar."
            as="p"
            className="font-sans text-xs text-neutral-500 leading-relaxed font-light"
            multiline
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Frequently Asked Questions -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-6 sm:px-8">
      <div class="text-center mb-14">
        <EditableText
          client:load
          contentKey="services.faq.label"
          defaultText="Dudas Habituales"
          as="span"
          className="font-sans text-[11px] tracking-[0.25em] uppercase text-neutral-400 font-medium block mb-2"
        />
        <EditableText
          client:load
          contentKey="services.faq.title"
          defaultText="Preguntas Frecuentes"
          as="h2"
          className="font-serif text-3xl sm:text-4xl text-neutral-900 font-normal"
        />
      </div>

      <div class="space-y-6 divide-y divide-neutral-100">
        <div class="pt-6">
          <EditableText
            client:load
            contentKey="services.faq.q1"
            defaultText="¿Con cuánto tiempo de antelación debo reservar una boda?"
            as="h3"
            className="font-serif text-xl text-neutral-900 font-normal mb-2"
          />
          <EditableText
            client:load
            contentKey="services.faq.a1"
            defaultText="Se recomienda reservar con 6 a 12 meses de anticipación, especialmente para fines de semana en temporada alta de bodas (primavera y otoño)."
            as="p"
            className="font-sans text-sm text-neutral-600 font-light leading-relaxed"
            multiline
          />
        </div>

        <div class="pt-6">
          <EditableText
            client:load
            contentKey="services.faq.q2"
            defaultText="¿Te trasladas fuera de tu ciudad o internacionalmente?"
            as="h3"
            className="font-serif text-xl text-neutral-900 font-normal mb-2"
          />
          <EditableText
            client:load
            contentKey="services.faq.a2"
            defaultText="Sí. He viajado para documentar bodas en diversas locaciones y destinos. Los costos de traslado y hospedaje se cotizan con total transparencia según el destino."
            as="p"
            className="font-sans text-sm text-neutral-600 font-light leading-relaxed"
            multiline
          />
        </div>

        <div class="pt-6">
          <EditableText
            client:load
            contentKey="services.faq.q3"
            defaultText="¿El cuadro se entrega terminado la misma noche?"
            as="h3"
            className="font-serif text-xl text-neutral-900 font-normal mb-2"
          />
          <EditableText
            client:load
            contentKey="services.faq.a3"
            defaultText="Al finalizar el evento la pintura estará entre un 85% y 95% completa para que los novios e invitados puedan apreciarla. Posteriormente regresa al estudio para detallado fino de rostros, secado y barniz de conservación."
            as="p"
            className="font-sans text-sm text-neutral-600 font-light leading-relaxed"
            multiline
          />
        </div>

        <div class="pt-6">
          <EditableText
            client:load
            contentKey="services.faq.q4"
            defaultText="¿Cómo encargar un retrato si no estoy en la misma ciudad?"
            as="h3"
            className="font-serif text-xl text-neutral-900 font-normal mb-2"
          />
          <EditableText
            client:load
            contentKey="services.faq.a4"
            defaultText="El proceso es 100% digitalizado: me envías tus fotografías favoritas, definimos composición y tamaño, y te envío fotos del avance por WhatsApp o correo antes de embalar y enviar el lienzo terminado."
            as="p"
            className="font-sans text-sm text-neutral-600 font-light leading-relaxed"
            multiline
          />
        </div>
      </div>

      <div class="text-center mt-16 reveal-on-scroll">
        <a
          href={`${base}/contact`}
          class="inline-block px-10 py-4 bg-neutral-950 text-white hover:bg-neutral-800 text-xs font-sans tracking-[0.25em] uppercase font-medium transition-colors"
        >
          <EditableText
            client:load
            contentKey="services.cta.btn"
            defaultText="Iniciar Consulta de Servicio"
            as="span"
          />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
