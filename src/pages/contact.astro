---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
import EditableText from '../components/editor/EditableText';
---

<BaseLayout
  title="Contacto & Reservas · Lía Paz | Consultas de Arte y Bodas"
  description="Ponte en contacto con la artista visual Lía Paz para cotizar tu Wedding Live Painting, encargo de retrato al óleo o consultas generales."
>
  <!-- Page Header -->
  <section class="py-12 sm:py-16 md:py-24 border-b border-neutral-100 bg-neutral-50/50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <EditableText
        client:load
        contentKey="contact.header.label"
        defaultText="Conversemos"
        as="span"
        className="font-sans text-[11px] tracking-[0.3em] uppercase text-neutral-400 font-medium block mb-3"
      />
      <EditableText
        client:load
        contentKey="contact.header.title"
        defaultText="Contacto & Reservas"
        as="h1"
        className="font-serif text-4xl sm:text-5xl md:text-6xl text-neutral-900 font-normal tracking-wide block"
      />
      <EditableText
        client:load
        contentKey="contact.header.desc"
        defaultText="Cuéntame sobre tu fecha de boda o la idea de retrato que imaginas. Me encantará acompañarte a materializarla en lienzo."
        as="p"
        className="font-sans text-sm sm:text-base text-neutral-500 font-light max-w-xl mx-auto mt-4 leading-relaxed block"
        multiline
      />
    </div>
  </section>

  <!-- Contact Form & Details Section -->
  <section class="py-12 sm:py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        <!-- Left Column: Info & Social Presence -->
        <div class="lg:col-span-5 space-y-10 reveal-on-scroll">
          <div>
            <EditableText
              client:load
              contentKey="contact.avail.label"
              defaultText="Disponibilidad"
              as="span"
              className="font-sans text-[11px] tracking-[0.2em] uppercase text-neutral-400 font-medium block mb-2"
            />
            <EditableText
              client:load
              contentKey="contact.avail.title"
              defaultText="Agenda Abierta 2025 & 2026"
              as="h2"
              className="font-serif text-2xl sm:text-3xl text-neutral-900 font-normal mb-3 block"
            />
            <EditableText
              client:load
              contentKey="contact.avail.desc"
              defaultText="Las fechas para bodas son limitadas para garantizar dedicación exclusiva a cada pareja. Se recomienda reservar con varios meses de antelación."
              as="p"
              className="font-sans text-sm text-neutral-600 font-light leading-relaxed block"
              multiline
            />
          </div>

          <!-- Direct Links -->
          <div class="space-y-6 pt-4 border-t border-neutral-100">
            <div>
              <span class="font-sans text-xs tracking-widest uppercase text-neutral-400 block mb-1">
                Instagram Direct
              </span>
              <a
                href="https://www.instagram.com/fracta.lia/"
                target="_blank"
                rel="noopener noreferrer"
                class="font-sans text-base text-neutral-900 hover:text-neutral-600 font-medium flex items-center space-x-2 transition-colors"
              >
                <span>@fracta.lia</span>
                <span class="text-xs">&rarr;</span>
              </a>
              <p class="text-xs text-neutral-400 mt-1">
                También puedes enviarme un mensaje directo por Instagram para consultas rápidas.
              </p>
            </div>

            <div>
              <span class="font-sans text-xs tracking-widest uppercase text-neutral-400 block mb-1">
                Correo Electrónico
              </span>
              <a
                href="mailto:liapazart@gmail.com"
                class="font-sans text-base text-neutral-900 hover:text-neutral-600 font-medium flex items-center space-x-2 transition-colors"
              >
                <span>liapazart@gmail.com</span>
                <span class="text-xs">&rarr;</span>
              </a>
              <p class="text-xs text-neutral-400 mt-1">
                Para consultas de bodas, cotizaciones formales y encargos de obra original.
              </p>
            </div>

            <div>
              <span class="font-sans text-xs tracking-widest uppercase text-neutral-400 block mb-1">
                Cobertura Geográfica
              </span>
              <p class="font-sans text-sm text-neutral-700 font-light">
                Disponible para eventos y traslados a nivel nacional e internacional.
              </p>
            </div>

            <div>
              <span class="font-sans text-xs tracking-widest uppercase text-neutral-400 block mb-1">
                Tiempo de Respuesta
              </span>
              <p class="font-sans text-sm text-neutral-700 font-light">
                Menos de 24 a 48 horas en días hábiles.
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Form Island -->
        <div class="lg:col-span-7 reveal-on-scroll delay-150">
          <ContactForm client:load />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

