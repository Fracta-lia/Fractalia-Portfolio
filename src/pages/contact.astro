---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
---

<BaseLayout
  title="Contacto & Reservas · Lía Paz | Consultas de Arte y Bodas"
  description="Ponte en contacto con la artista visual Lía Paz para cotizar tu Wedding Live Painting, encargo de retrato al óleo o consultas generales."
>
  <!-- Page Header -->
  <section class="py-16 md:py-24 border-b border-neutral-100 bg-neutral-50/50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="font-sans text-[11px] tracking-[0.3em] uppercase text-neutral-400 font-medium block mb-3">
        Conversemos
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl text-neutral-900 font-normal tracking-wide">
        Contacto & Reservas
      </h1>
      <p class="font-sans text-sm sm:text-base text-neutral-500 font-light max-w-xl mx-auto mt-4 leading-relaxed">
        Cuéntame sobre tu fecha de boda o la idea de retrato que imaginas. Me encantará acompañarte a materializarla en lienzo.
      </p>
    </div>
  </section>

  <!-- Contact Form & Details Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        <!-- Left Column: Info & Social Presence -->
        <div class="lg:col-span-5 space-y-10">
          <div>
            <span class="font-sans text-[11px] tracking-[0.2em] uppercase text-neutral-400 font-medium block mb-2">
              Disponibilidad
            </span>
            <h2 class="font-serif text-2xl sm:text-3xl text-neutral-900 font-normal mb-3">
              Agenda Abierta 2025 & 2026
            </h2>
            <p class="font-sans text-sm text-neutral-600 font-light leading-relaxed">
              Las fechas para bodas son limitadas para garantizar dedicación exclusiva a cada pareja. Se recomienda reservar con varios meses de antelación.
            </p>
          </div>

          <!-- Direct Links -->
          <div class="space-y-6 pt-4 border-t border-neutral-100">
            <div>
              <span class="font-sans text-xs tracking-widest uppercase text-neutral-400 block mb-1">
                Instagram Direct
              </span>
              <a
                href="https://www.instagram.com/fracta.lia/"
                target="_blank"
                rel="noopener noreferrer"
                class="font-sans text-base text-neutral-900 hover:text-neutral-600 font-medium flex items-center space-x-2 transition-colors"
              >
                <span>@fracta.lia</span>
                <span class="text-xs">&rarr;</span>
              </a>
              <p class="text-xs text-neutral-400 mt-1">
                También puedes enviarme un mensaje directo por Instagram para consultas rápidas.
              </p>
            </div>

            <div>
              <span class="font-sans text-xs tracking-widest uppercase text-neutral-400 block mb-1">
                Cobertura Geográfica
              </span>
              <p class="font-sans text-sm text-neutral-700 font-light">
                Disponible para eventos y traslados a nivel nacional e internacional.
              </p>
            </div>

            <div>
              <span class="font-sans text-xs tracking-widest uppercase text-neutral-400 block mb-1">
                Tiempo de Respuesta
              </span>
              <p class="font-sans text-sm text-neutral-700 font-light">
                Menos de 24 a 48 horas en días hábiles.
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Form Island -->
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

