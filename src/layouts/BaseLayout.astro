---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SaveBar from '../components/editor/SaveBar';
import siteContentEs from '../data/siteContent.json';
import siteContentEn from '../data/siteContent.en.json';
import { uiTranslations } from '../i18n/translations';

const allTranslations = {
  es: { ...uiTranslations.es, ...siteContentEs },
  en: { ...uiTranslations.en, ...siteContentEn }
};

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Lía Paz · Fine Art & Live Wedding Paintings | Fractalia',
  description = 'Portafolio de la artista visual Lía Paz (Fractalia). Pintura al óleo figurativa, live wedding paintings para bodas y retratos personalizados por encargo.',
  image = '/images/gallery/mares-de-silencio.webp',
  imageAlt = 'Lía Paz · Arte Visual & Live Painting',
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://liapaz.com';
const cleanPath = currentPath.replace(/\/$/, '') || '/';
const canonicalURL = cleanPath === '/' ? `${siteUrl}/` : `${siteUrl}${cleanPath}`;
const absoluteImage = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

// Global Base Structured Data: VisualArtist + WebSite
const defaultArtistSchema = {
  '@context': 'https://schema.org',
  '@type': ['Person', 'VisualArtist'],
  '@id': `${siteUrl}/#artist`,
  name: 'Lía Paz',
  alternateName: ['Fractalia', 'Lía Paz Art', 'Lia Paz'],
  url: `${siteUrl}/`,
  image: `${siteUrl}/images/about/lia-paz.webp`,
  description: 'Artista visual mexicana especializada en pintura al óleo figurativa contemporánea, live wedding paintings para bodas y retratos por encargo.',
  jobTitle: 'Artista Visual & Pintora en Vivo',
  sameAs: ['https://www.instagram.com/fracta.lia/'],
  email: 'mailto:liapazart@gmail.com',
  knowsAbout: [
    'Pintura al óleo',
    'Live Wedding Painting',
    'Retratos al óleo personalizados',
    'Arte contemporáneo',
    'Bellas artes'
  ],
  homeLocation: {
    '@type': 'Place',
    name: 'México'
  }
};

const defaultWebSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: `${siteUrl}/`,
  name: 'Lía Paz · Fine Art & Live Paintings',
  alternateName: 'Fractalia',
  description: 'Portafolio oficial y servicios de pintura en vivo para bodas y retratos por la artista visual Lía Paz.',
  publisher: { '@id': `${siteUrl}/#artist` },
  inLanguage: 'es-MX'
};

const breadcrumbsSchema = currentPath !== '/' ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Inicio',
      'item': `${siteUrl}/`
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': title.split('·')[0].trim() || 'Página',
      'item': canonicalURL
    }
  ]
} : null;

const structuredDataArray = [
  defaultArtistSchema,
  defaultWebSiteSchema,
  ...(breadcrumbsSchema ? [breadcrumbsSchema] : []),
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#141414" />
    <meta name="color-scheme" content="light" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Lía Paz · Arte Visual" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- AI & GEO Discovery Links -->
    <link rel="author" href={`${siteUrl}/about`} />
    <link rel="help" type="text/plain" href={`${siteUrl}/llms.txt`} title="LLM Context Document" />

    <!-- Structured Data (JSON-LD) -->
    {structuredDataArray.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Google Fonts: Cormorant Garamond & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Language Detection & Universal Instant Translation Engine -->
    <script is:inline define:vars={{ allTranslations }}>
      (function() {
        const getPreferredLang = () => {
          try {
            const saved = localStorage.getItem('lia_lang');
            if (saved === 'es' || saved === 'en') return saved;
            const langs = navigator.languages || [navigator.language || ''];
            for (const l of langs) {
              if (l.toLowerCase().startsWith('es')) return 'es';
              if (l.toLowerCase().startsWith('en')) return 'en';
            }
          } catch (e) {}
          return 'en';
        };

        const updateButtons = (lang) => {
          document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
            const btnLang = btn.getAttribute('data-lang-btn');
            if (btnLang === lang) {
              btn.className = 'px-1 py-0.5 transition-all cursor-pointer text-neutral-950 font-semibold border-b border-neutral-900';
              btn.setAttribute('aria-current', 'true');
            } else {
              btn.className = 'px-1 py-0.5 transition-all cursor-pointer text-neutral-400 hover:text-neutral-800';
              btn.removeAttribute('aria-current');
            }
          });
        };

        const applyTranslations = (lang) => {
          document.documentElement.lang = lang;
          const dict = allTranslations[lang] || allTranslations.en;
          const elements = document.querySelectorAll('[data-i18n]');
          elements.forEach((el) => {
            const key = el.getAttribute('data-i18n');
            if (key && dict[key] !== undefined) {
              if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                el.placeholder = dict[key];
              } else {
                el.textContent = dict[key];
              }
            }
          });
          updateButtons(lang);
        };

        window.__liaTranslations = allTranslations;
        window.__liaApplyI18n = applyTranslations;

        window.__liaSetLang = function(newLang) {
          if (newLang !== 'es' && newLang !== 'en') return;
          try {
            localStorage.setItem('lia_lang', newLang);
          } catch (e) {}

          applyTranslations(newLang);
          window.dispatchEvent(new CustomEvent('lia_lang_change', { detail: { lang: newLang } }));
        };

        // Delegated click listener: responds immediately even before React islands hydrate
        document.addEventListener('click', function(e) {
          const btn = e.target && e.target.closest ? e.target.closest('[data-lang-btn]') : null;
          if (btn) {
            const target = btn.getAttribute('data-lang-btn');
            if (target === 'es' || target === 'en') {
              window.__liaSetLang(target);
            }
          }
        });

        const initialLang = getPreferredLang();
        document.documentElement.lang = initialLang;

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => {
            applyTranslations(initialLang);
          });
        } else {
          applyTranslations(initialLang);
        }

        window.addEventListener('lia_lang_change', (e) => {
          const lang = e?.detail?.lang || getPreferredLang();
          applyTranslations(lang);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-neutral-900 font-sans selection:bg-neutral-900 selection:text-white antialiased">
    <Header currentPath={currentPath} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <SaveBar client:load />

    <!-- Smooth Luxury Reveal on Scroll Script -->
    <script is:inline>
      (function() {
        const setupScrollReveal = () => {
          // If reduced motion is preferred or in edit mode, reveal immediately without animation
          const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const isEditMode = window.location.search.includes('edit=true') || localStorage.getItem('lia_edit_mode') === 'true';

          if (isEditMode) {
            document.body.classList.add('is-edit-mode');
            document.body.setAttribute('data-edit-mode', 'true');
          }

          const elements = document.querySelectorAll('.reveal-on-scroll');
          if (isReducedMotion || isEditMode) {
            elements.forEach(el => el.classList.add('is-revealed'));
            return;
          }

          if (!('IntersectionObserver' in window)) {
            elements.forEach(el => el.classList.add('is-revealed'));
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  observer.unobserve(entry.target);
                }
              });
            },
            {
              threshold: 0.08,
              rootMargin: '0px 0px -40px 0px',
            }
          );

          elements.forEach((el) => observer.observe(el));

          // Also observe dynamically mounted elements (e.g. React islands)
          if ('MutationObserver' in window) {
            const mutationObserver = new MutationObserver((mutations) => {
              mutations.forEach((m) => {
                m.addedNodes.forEach((node) => {
                  if (node.nodeType === 1) {
                    const el = node;
                    if (el.classList?.contains('reveal-on-scroll')) {
                      observer.observe(el);
                    }
                    el.querySelectorAll?.('.reveal-on-scroll').forEach((child) => observer.observe(child));
                  }
                });
              });
            });
            mutationObserver.observe(document.body, { childList: true, subtree: true });
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setupScrollReveal);
        } else {
          setupScrollReveal();
        }
      })();
    </script>
  </body>
</html>


