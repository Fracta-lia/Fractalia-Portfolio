---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SaveBar from '../components/editor/SaveBar';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Lía Paz · Fine Art & Live Wedding Paintings | Fractalia',
  description = 'Portafolio de la artista visual Lía Paz (Fractalia). Pintura al óleo figurativa, live wedding paintings para bodas y retratos personalizados por encargo.',
  image = '/images/gallery/mares-de-silencio.webp',
  imageAlt = 'Lía Paz · Arte Visual & Live Painting',
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://liapaz.com';
const cleanPath = currentPath.replace(/\/$/, '') || '/';
const canonicalURL = cleanPath === '/' ? `${siteUrl}/` : `${siteUrl}${cleanPath}`;
const absoluteImage = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

// Global Base Structured Data: VisualArtist + WebSite
const defaultArtistSchema = {
  '@context': 'https://schema.org',
  '@type': ['Person', 'VisualArtist'],
  '@id': `${siteUrl}/#artist`,
  name: 'Lía Paz',
  alternateName: ['Fractalia', 'Lía Paz Art', 'Lia Paz'],
  url: `${siteUrl}/`,
  image: `${siteUrl}/images/about/lia-paz.webp`,
  description: 'Artista visual mexicana especializada en pintura al óleo figurativa contemporánea, live wedding paintings para bodas y retratos por encargo.',
  jobTitle: 'Artista Visual & Pintora en Vivo',
  sameAs: ['https://www.instagram.com/fracta.lia/'],
  email: 'mailto:liapazart@gmail.com',
  knowsAbout: [
    'Pintura al óleo',
    'Live Wedding Painting',
    'Retratos al óleo personalizados',
    'Arte contemporáneo',
    'Bellas artes'
  ],
  homeLocation: {
    '@type': 'Place',
    name: 'México'
  }
};

const defaultWebSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: `${siteUrl}/`,
  name: 'Lía Paz · Fine Art & Live Paintings',
  alternateName: 'Fractalia',
  description: 'Portafolio oficial y servicios de pintura en vivo para bodas y retratos por la artista visual Lía Paz.',
  publisher: { '@id': `${siteUrl}/#artist` },
  inLanguage: 'es-MX'
};

const breadcrumbsSchema = currentPath !== '/' ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Inicio',
      'item': `${siteUrl}/`
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': title.split('·')[0].trim() || 'Página',
      'item': canonicalURL
    }
  ]
} : null;

const structuredDataArray = [
  defaultArtistSchema,
  defaultWebSiteSchema,
  ...(breadcrumbsSchema ? [breadcrumbsSchema] : []),
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#141414" />
    <meta name="color-scheme" content="light" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Lía Paz · Arte Visual" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- AI & GEO Discovery Links -->
    <link rel="author" href={`${siteUrl}/about`} />
    <link rel="help" type="text/plain" href={`${siteUrl}/llms.txt`} title="LLM Context Document" />

    <!-- Structured Data (JSON-LD) -->
    {structuredDataArray.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Google Fonts: Cormorant Garamond & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Language Detection & Dynamic Translation Script -->
    <script is:inline>
      (function() {
        const getPreferredLang = () => {
          try {
            const saved = localStorage.getItem('lia_lang');
            if (saved === 'es' || saved === 'en') return saved;
            const langs = navigator.languages || [navigator.language || ''];
            for (const l of langs) {
              if (l.toLowerCase().startsWith('es')) return 'es';
              if (l.toLowerCase().startsWith('en')) return 'en';
            }
          } catch (e) {}
          return 'en';
        };

        const currentLang = getPreferredLang();
        document.documentElement.lang = currentLang;

        const translations = {
          es: {
            'nav.home': 'Inicio',
            'nav.gallery': 'Galería',
            'nav.services': 'Servicios',
            'nav.about': 'Sobre Mí',
            'nav.contact': 'Contacto',
            'footer.copyright': 'Todos los derechos reservados.',
            'home.hero.discover': 'Descubrir',
            'home.gallery.explore_btn': 'Explorar Galería Completa',
            'home.services.explore_btn': 'Conocer detalles & tarifas',
            'contact.direct_ig_label': 'Instagram Direct',
            'contact.direct_ig_desc': 'También puedes enviarme un mensaje directo por Instagram para consultas rápidas.',
            'contact.email_label': 'Correo Electrónico',
            'contact.email_desc': 'Para consultas de bodas, cotizaciones formales y encargos de obra original.',
            'contact.coverage_label': 'Cobertura Geográfica',
            'contact.coverage_desc': 'Disponible para eventos y traslados a nivel nacional e internacional.',
            'contact.response_label': 'Tiempo de Respuesta',
            'contact.response_desc': 'Menos de 24 a 48 horas en días hábiles.',
            '404.badge': 'Error 404 · Sala Inexistente',
            '404.title': 'Esta obra no se encuentra aquí',
            '404.desc': 'La página o pieza que intentas consultar ha sido reubicada o el enlace no es el correcto. Te invitamos a continuar descubriendo la colección.',
            '404.gallery_btn': 'Explorar Galería',
            '404.home_btn': 'Volver al Inicio',
            'about.location_caption': 'Lía Paz en su estudio · Puebla, México',
            'about.follow_label': 'Sígueme en el proceso:'
          },
          en: {
            'nav.home': 'Home',
            'nav.gallery': 'Gallery',
            'nav.services': 'Services',
            'nav.about': 'About',
            'nav.contact': 'Contact',
            'footer.copyright': 'All rights reserved.',
            'home.hero.discover': 'Discover',
            'home.gallery.explore_btn': 'Explore Full Gallery',
            'home.services.explore_btn': 'View Details & Pricing',
            'contact.direct_ig_label': 'Instagram Direct',
            'contact.direct_ig_desc': 'You can also send me a direct message on Instagram for quick inquiries.',
            'contact.email_label': 'Email Address',
            'contact.email_desc': 'For wedding inquiries, formal quotes, and original artwork commissions.',
            'contact.coverage_label': 'Geographic Coverage',
            'contact.coverage_desc': 'Available for domestic travel across Mexico and worldwide destination weddings.',
            'contact.response_label': 'Response Time',
            'contact.response_desc': 'Usually within 24 to 48 business hours.',
            '404.badge': 'Error 404 · Room Not Found',
            '404.title': 'This artwork is not here',
            '404.desc': 'The page or piece you are looking for has been relocated or the link is incorrect. We invite you to continue exploring the collection.',
            '404.gallery_btn': 'Explore Gallery',
            '404.home_btn': 'Back to Home',
            'about.location_caption': 'Lía Paz in her studio · Puebla, Mexico',
            'about.follow_label': 'Follow the creative process:'
          }
        };

        const applyTranslations = (lang) => {
          document.documentElement.lang = lang;
          const dict = translations[lang] || translations.en;
          const elements = document.querySelectorAll('[data-i18n]');
          elements.forEach((el) => {
            const key = el.getAttribute('data-i18n');
            if (key && dict[key]) {
              el.textContent = dict[key];
            }
          });
        };

        window.liaApplyI18n = applyTranslations;

        const init = () => {
          applyTranslations(getPreferredLang());
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }

        window.addEventListener('lia_lang_change', (e) => {
          const lang = e?.detail?.lang || getPreferredLang();
          applyTranslations(lang);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-neutral-900 font-sans selection:bg-neutral-900 selection:text-white antialiased">
    <Header currentPath={currentPath} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <SaveBar client:load />

    <!-- Smooth Luxury Reveal on Scroll Script -->
    <script is:inline>
      (function() {
        const setupScrollReveal = () => {
          // If reduced motion is preferred or in edit mode, reveal immediately without animation
          const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const isEditMode = window.location.search.includes('edit=true') || localStorage.getItem('lia_edit_mode') === 'true';

          if (isEditMode) {
            document.body.classList.add('is-edit-mode');
            document.body.setAttribute('data-edit-mode', 'true');
          }

          const elements = document.querySelectorAll('.reveal-on-scroll');
          if (isReducedMotion || isEditMode) {
            elements.forEach(el => el.classList.add('is-revealed'));
            return;
          }

          if (!('IntersectionObserver' in window)) {
            elements.forEach(el => el.classList.add('is-revealed'));
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  observer.unobserve(entry.target);
                }
              });
            },
            {
              threshold: 0.08,
              rootMargin: '0px 0px -40px 0px',
            }
          );

          elements.forEach((el) => observer.observe(el));

          // Also observe dynamically mounted elements (e.g. React islands)
          if ('MutationObserver' in window) {
            const mutationObserver = new MutationObserver((mutations) => {
              mutations.forEach((m) => {
                m.addedNodes.forEach((node) => {
                  if (node.nodeType === 1) {
                    const el = node;
                    if (el.classList?.contains('reveal-on-scroll')) {
                      observer.observe(el);
                    }
                    el.querySelectorAll?.('.reveal-on-scroll').forEach((child) => observer.observe(child));
                  }
                });
              });
            });
            mutationObserver.observe(document.body, { childList: true, subtree: true });
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setupScrollReveal);
        } else {
          setupScrollReveal();
        }
      })();
    </script>
  </body>
</html>


