---
import EditableText from './editor/EditableText';

interface Props {
  keyPrefix?: string;
  title: string;
  tagline: string;
  description: string;
  details: string[];
  image: string;
  ctaText?: string;
  ctaHref?: string;
  reversed?: boolean;
}

const {
  keyPrefix = 'services.card',
  title,
  tagline,
  description,
  details,
  image,
  ctaText = 'Cotizar Servicio',
  ctaHref = '/contact',
  reversed = false,
} = Astro.props;

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
const fullCtaHref = ctaHref.startsWith('http') ? ctaHref : `${base}${ctaHref}`;
---

<div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center py-12 md:py-20 border-b border-neutral-100 last:border-b-0`}>
  {/* Image Column */}
  <div class={`lg:col-span-7 ${reversed ? 'lg:order-2' : 'lg:order-1'}`}>
    <div class="relative overflow-hidden bg-neutral-100 aspect-[4/3] group border border-neutral-200/60">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
        loading="lazy"
      />
    </div>
  </div>

  {/* Content Column */}
  <div class={`lg:col-span-5 flex flex-col justify-center space-y-6 ${reversed ? 'lg:order-1' : 'lg:order-2'}`}>
    <div>
      <EditableText
        client:load
        contentKey={`${keyPrefix}.tagline`}
        defaultText={tagline}
        as="span"
        className="font-sans text-[11px] tracking-[0.25em] text-neutral-400 uppercase font-medium block"
      />
      <EditableText
        client:load
        contentKey={`${keyPrefix}.title`}
        defaultText={title}
        as="h2"
        className="font-serif text-3xl sm:text-4xl text-neutral-900 tracking-wide font-normal mt-2 block"
      />
    </div>

    <EditableText
      client:load
      contentKey={`${keyPrefix}.desc`}
      defaultText={description}
      as="p"
      className="font-sans text-neutral-600 text-sm sm:text-base leading-relaxed font-light block"
      multiline
    />

    {/* Highlights / Features */}
    {details && details.length > 0 && (
      <ul class="space-y-2.5 pt-2 border-t border-neutral-100">
        {details.map((item, idx) => (
          <li class="flex items-start text-xs sm:text-sm text-neutral-700 font-sans font-light">
            <span class="text-neutral-900 mr-2.5">—</span>
            <EditableText
              client:load
              contentKey={`${keyPrefix}.d${idx}`}
              defaultText={item}
              as="span"
            />
          </li>
        ))}
      </ul>
    )}

    {/* CTA Button */}
    <div class="pt-4">
      <a
        href={fullCtaHref}
        class="inline-block px-7 py-3.5 border border-neutral-900 text-neutral-900 hover:bg-neutral-900 hover:text-white text-xs font-sans tracking-[0.2em] uppercase transition-all duration-300 font-medium"
      >
        <EditableText
          client:load
          contentKey={`${keyPrefix}.cta`}
          defaultText={ctaText}
          as="span"
        /> &rarr;
      </a>
    </div>
  </div>
</div>
